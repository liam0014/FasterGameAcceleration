// FasterGameAcceleration: convert game-speed-dependent UI timing back to
// approximately real-world time. TimeScaleCounter is the game's shared
// acceleration state: active scale = 1 + TimeScaleCounter * 0.25.
int FGA_LastTimeScaleCounter = 0;

float FGA_GetMessageTimeScale()
{
	float fScale = 1.0;

	// Only compensate acceleration. Normal speed, slow motion and pause retain
	// vanilla behaviour and avoid any possibility of division by zero.
	if (TimeScaleCounter > 0)
	{
		fScale = 1.0 + TimeScaleCounter * 0.25;
	}

	if (fScale < 1.0) fScale = 1.0;
	return fScale;
}

void FGA_UpdateLogTiming()
{
	// The engine caches Log.speed and Log.color_speed when LOG_AND_ACTIONS_INIT
	// is processed, so changing the attributes alone has no effect. Only refresh
	// when the acceleration state changes.
	if (FGA_LastTimeScaleCounter == TimeScaleCounter) return;
	FGA_LastTimeScaleCounter = TimeScaleCounter;

	float fScale = FGA_GetMessageTimeScale();

	ILogAndActions.Log.speed = 0.05 / fScale;
	ILogAndActions.Log.color_speed = 0.02 / fScale;
	ILogAndActions.PicInfo.color_speed = NOTIFICATIONS_SPEED / fScale;

	// Re-read the ordinary log settings cached inside ILogAndActions.
	SendMessage(&ILogAndActions,"lll",LOG_AND_ACTIONS_INIT,sti(InterfaceStates.BattleShow.FastCommand),sti(InterfaceStates.BattleShow.LogString));

	// Picture notifications have their own explicit refresh path.
	SendMessage(&ILogAndActions,"l",LOG_REFRESH_PIC);
}

